<?xml version="1.0" encoding="utf-8"?>
<!-- Mirror screen. Inflated without the app theme: no ?attr references here. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/container1"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000"
    android:orientation="vertical">

    <SurfaceView
        android:id="@+id/decoder_surface"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:id="@+id/nav_button_bar"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="#FF121316"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:visibility="gone"
        tools:visibility="visible">

        <ImageButton
            android:id="@+id/back_button"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_nav_button"
            android:contentDescription="Back"
            android:scaleType="center"
            android:src="@drawable/ic_nav_back" />

        <ImageButton
            android:id="@+id/home_button"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_nav_button"
            android:contentDescription="Home"
            android:scaleType="center"
            android:src="@drawable/ic_nav_home" />

        <ImageButton
            android:id="@+id/appswitch_button"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_nav_button"
            android:contentDescription="Recent apps"
            android:scaleType="center"
            android:src="@drawable/ic_nav_recents" />

        <ImageButton
            android:id="@+id/power_button"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_nav_button"
            android:contentDescription="Power"
            android:scaleType="center"
            android:src="@drawable/ic_nav_power" />

    </LinearLayout>

</LinearLayout>
