    <string name="connect_error_title_unauthorized">Debugging not authorized</string>
    <string name="connect_error_title_server">Could not start mirroring</string>
    <string name="connect_error_unauthorized">%1$s did not allow debugging.\n\nUnlock the target device, then tap “Allow” on the “Allow debugging?” prompt. Tick “Always allow from this computer” so you are not asked again.</string>
    <string name="connect_error_refused">%1$s was reached, but ADB is not listening on that port.\n\n• Android 11+: open Developer options → Wireless debugging and use the “IP address &amp; Port” shown there (the port changes every time), or use “Pair (Android 11+)”.\n• Any Android: plug the target in with a USB cable once and tap “USB → Wi-Fi”.</string>
    <string name="connect_error_unreachable">Could not reach %1$s.\n\n• Make sure both phones are on the same Wi-Fi network (guest networks often block this).\n• Check the IP address in the target\'s Wi-Fi settings.\n• Mobile hotspot also works: connect one phone to the other\'s hotspot.</string>
    <string name="connect_error_bad_address">%1$s is not a valid address.</string>
    <string name="connect_error_offline">%1$s is connected but offline.\n\nTurn Wireless debugging off and on again on the target device (or re-plug USB), then retry.</string>
    <string name="connect_error_unknown">Could not connect to %1$s.</string>
    <string name="connect_error_server">Connected to %1$s, but the scrcpy server could not be started on it. Make sure the target device is unlocked and retry. If Root mode is on, check that root (su) is granted to “Shell” on the target.</string>
    <string name="connect_error_stream_timeout">The device did not send any video. Unlock it and try again, or pick a lower resolution / H.264.</string>

